+static bool isNativeSwapchainExtension(const char* name) {
+    // Vortek owns the guest swapchain and strips VK_KHR_swapchain before
+    // creating the native device. Native present IDs, waits and maintenance
+    // cannot operate on XWindowSwapchain handles; none are implemented by
+    // this bridge. DXVK enables advertised optional extension names even
+    // when their feature structs are absent from the wire protocol.
+    static const char* unsupported[] = {
+        "VK_KHR_present_id", "VK_KHR_present_wait",
+        "VK_KHR_present_id2", "VK_KHR_present_wait2",
+        "VK_EXT_swapchain_maintenance1", "VK_KHR_swapchain_maintenance1",
+        "VK_GOOGLE_display_timing"
+    };
+    for (uint32_t i = 0; i < ARRAY_SIZE(unsupported); i++)
+        if (strcmp(name, unsupported[i]) == 0) return true;
+    return false;
+}
